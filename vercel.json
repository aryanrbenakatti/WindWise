
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "rewrites": [
        {
          "source": "/api/(.*)",
          "destination": "/$1"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
